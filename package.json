{
  "name": "pi-loop",
  "version": "0.1.0",
  "description": "Recurring prompts inside a pi session. Each loop fires as one trailing user message on its interval, survives restarts, and adds nothing else to the conversation.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "loop"
  ],
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-loop.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/bun": "^1.2.12",
    "typescript": "^5.6.0"
  }
}
